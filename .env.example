# At least one key. They are tried in this order; the first that answers wins.
# All free tiers as of Aug 2026. Model names drift — override with
# SPOILERGATE_MODEL_GROQ / _CEREBRAS / _GEMINI / _OPENROUTER if a default 404s.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# With no keys at all the app still runs, in extractive mode: gated episode
# summaries are shown directly instead of a written answer.

# Optional. Shows that visitors index themselves are written here as well as to
# the local index, so they survive a restart — a free host wipes the filesystem
# whenever the service sleeps. Any Postgres works; Neon's free tier is enough.
# Leave it unset and the app runs on the baked index alone, which is what a
# fork with no database of its own gets.
DATABASE_URL=
